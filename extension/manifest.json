{
  "manifest_version": 3,
  "name": "PageIntel",
  "version": "2.0",
  "description": "Chat with any webpage using AI. Compare responses from multiple models side by side.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.jpg"
  },
  "host_permissions": [
    "http://localhost:8000/",
    "http://127.0.0.1:8000/"
  ]
}